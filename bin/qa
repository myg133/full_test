#!/usr/bin/env node
/**
 * qa —— 测试套件工具链自举入口（REQ-003）
 *
 * 本文件是**薄启动器**：真正的实现见同目录的 `bin/qa-impl.mjs`。
 *
 * 为什么拆成两个文件：
 *   本包 `package.json` 声明了 `"type": "module"`，而 `bin/qa` 是**无扩展名**文件。
 *   - Node 18/20：无扩展名文件按 CommonJS 加载；
 *   - Node 22+（含本机 v26）：无扩展名文件按包的 `type` 字段当 ESM 加载。
 *   同一份源码无法同时用 `require` 和 `import` 两种语法。
 *   动态 `import()` 在 CommonJS 与 ESM 下都合法，因此启动器用它加载 `.mjs` 实现，
 *   从而在 Node 18 与 Node 22+ 上行为一致。
 *
 * 职责边界（见 references/tools-chain-contract.md）：
 *   - 入口是**包级** CLI（进 npm 包），管理**项目级** `<project-root>/.tools/`；
 *   - 工具清单在 `<project-root>/.tools/manifest.json`（进 Git）；
 *   - 安装产物一律落在 `<project-root>/.tools/` 之内，绝不污染系统环境；
 *   - 工具装不上必须显式报 `failed` / `unavailable`，不得静默跳过。
 */

'use strict';

import('./qa-impl.mjs')
  .then((mod) => mod.main(process.argv.slice(2)))
  .then((code) => {
    process.exitCode = typeof code === 'number' ? code : 0;
  })
  .catch((err) => {
    const message = err && err.message ? err.message : String(err);
    console.error(`[error] qa 启动失败：${message}`);
    process.exit(2);
  });
